<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             xmlns:controls="using:happy_agent_coding.Controls"
             x:Class="happy_agent_coding.Views.BlueprintEditorView"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="220,*"
          Background="{DynamicResource LayerFillColorBrush}">
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="10,8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="积木"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="4,2,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding BlueprintEditor.ClassPage.ObjectName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0" />
                        <TextBlock Text="{Binding BlueprintEditor.ClassPage.ClassName}"
                                   FontSize="10"
                                   Opacity="0.6"
                                   Margin="4,-4,0,4" />
                        <ListBox ItemsSource="{Binding BlueprintEditor.ClassPage.Canvases}"
                                 SelectedItem="{Binding BlueprintEditor.ClassPage.SelectedCanvas, Mode=TwoWay}"
                                 Background="Transparent"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlueprintCanvasEntry">
                                    <TextBlock Text="{Binding Title}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Expander Header="节点" IsExpanded="True">
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10,6" Opacity="0.75">
                                    <TextBlock Text="当启动时" />
                                </Border>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10,6" Opacity="0.75">
                                    <TextBlock Text="当角色被点击" />
                                </Border>
                            </StackPanel>
                        </Expander>
                        <Expander Header="运动">
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Button Content="移动 10 步" Tag="self.move(10)" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <Button Content="旋转 15 度" Tag="self.turn(15)" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="控制">
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Button Content="重复执行 10 次" Tag="for _ in range(10):&#10;    pass" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <Button Content="计数循环" Tag="for i in range(10):&#10;    pass" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <Button Content="重复直到条件" Tag="while True:&#10;    pass" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <Button Content="列表遍历" Tag="for item in list_values(&quot;list1&quot;):&#10;    pass" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="数据">
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Button Content="设置变量" Tag="self.health = 100" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                <Button Content="增加变量" Tag="self.health += 1" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="外观">
                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <Button Content="切换造型" Tag="self.switch_costume(&quot;costume1&quot;)" Click="OnPaletteInsert"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="变量"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="4,12,0,2"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding BlueprintEditor.VariablePalette.SearchText, Mode=TwoWay}"
                                 PlaceholderText="搜索变量"
                                 Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding BlueprintEditor.VariablePalette.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VariableTemplateGroup">
                                    <Expander Header="{Binding Title}"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              IsVisible="{Binding HasVisibleItems}"
                                              Margin="0,0,0,2">
                                        <ItemsControl ItemsSource="{Binding FilteredItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VariableTemplateItem">
                                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="5"
                                                            Padding="8,5"
                                                            Margin="0,2">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       ToolTip.Tip="{Binding HoverText}" />
                                                            <TextBlock Text="{Binding GeneratedCode}"
                                                                       FontSize="10"
                                                                       Opacity="0.62" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Column="1"
                Margin="16"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,14,18,10">
                <TextBlock Grid.Row="0"
                           Text="{Binding BlueprintEditor.Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="0,12,0,8"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <controls:BlueprintWorkspace Document="{Binding BlueprintEditor.Document}"
                                                   NodeSelected="OnNodeSelected"
                                                   NodeMoved="OnBlueprintNodeMoved"
                                                   ReconnectRequested="OnBlueprintReconnect"
                                                   AnnotationRequested="OnBlueprintAnnotation"
                                                   ValueEdited="OnBlueprintValueEdited"
                                                   InsertRequested="OnWorkspaceInsert"
                                                   DeleteRequested="OnWorkspaceDelete"
                                                   ArrangeRequested="OnWorkspaceArrange">

                    </controls:BlueprintWorkspace>
                </Border>
                <StackPanel Grid.Row="3" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <Button Content="管理项目变量…" Click="OnManageProjectVariables" />
                        <Button Content="重新排列节点" Click="OnArrangeBlueprintNodes" />
                    </StackPanel>
                    <TextBlock Text="节点画布读取当前脚本的启动区域；拖拽只改变视图坐标，Python 顺序不变。"
                               IsVisible="{Binding BlueprintEditor.IsEmpty}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding BlueprintEditor.Status}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
