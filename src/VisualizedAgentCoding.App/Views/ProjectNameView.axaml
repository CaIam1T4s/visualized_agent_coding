<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="happy_agent_coding.Views.ProjectNameView"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#99000000">
        <Border Width="520" Margin="24" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Padding="24,10,20,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="新建项目" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="caption-button" Click="OnCancel" ToolTip.Tip="取消创建">
                            <TextBlock Classes="caption-glyph" Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="24" Spacing="12">
                    <TextBlock Text="项目所在目录" FontWeight="SemiBold" />
                    <TextBlock x:Name="ParentDirectory" TextWrapping="Wrap" />
                    <TextBlock Text="项目名称" FontWeight="SemiBold" />
                    <TextBox x:Name="ProjectName" PlaceholderText="例如：我的第一个项目" TextChanged="OnNameChanged"
                             AutomationProperties.Name="项目名称" />
                    <TextBlock Text="将在所选目录下创建同名文件夹：" />
                    <TextBlock x:Name="RootPreview" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="ValidationError" IsVisible="False" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="取消" Classes="command-button secondary" Click="OnCancel" />
                        <Button Content="创建项目" Classes="command-button primary" Click="OnAccept" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
