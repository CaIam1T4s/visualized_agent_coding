<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="happy_agent_coding.Views.AddMethodView"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#99000000">
        <Border Width="440" MaxWidth="600" Margin="24" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Padding="24,10,20,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="添加自定义方法" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="caption-button" Click="OnCancel" ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
                            <TextBlock Classes="caption-glyph" Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="24" Spacing="16">
                    <TextBlock Text="方法名称" />
                    <TextBox x:Name="MethodName" PlaceholderText="方法名称" Text="my_method" />
                    <TextBlock x:Name="ValidationError" IsVisible="False" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="取消" Classes="command-button secondary" Click="OnCancel" />
                        <Button Content="添加" Classes="command-button primary" Click="OnAccept" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
