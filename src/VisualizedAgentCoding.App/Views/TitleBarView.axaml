<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             x:Class="happy_agent_coding.Views.TitleBarView"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource LayerFillColorBrush}">
        <Border Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                <ContentControl x:Name="TitleBarAppIcon" Width="16" Height="16" />
                <TextBlock Text="Visualized Agent Coding"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Button Grid.Column="1"
                Classes="titlebar-save-button"
                Command="{Binding SaveCommand}"
                ToolTip.Tip="保存"
                AutomationProperties.Name="保存">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ContentControl x:Name="SaveIcon" Width="16" Height="16" />
                <TextBlock Text="保存" />
            </StackPanel>
        </Button>
        <Border Grid.Column="2"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0">
            <Button Classes="caption-button"
                    Click="OnMinimizeClick"
                    ToolTip.Tip="最小化"
                    AutomationProperties.Name="最小化">
                <TextBlock Classes="caption-glyph" Text="&#xE921;" />
            </Button>
            <Button x:Name="MaximizeButton"
                    Classes="caption-button"
                    Click="OnMaximizeRestoreClick"
                    ToolTip.Tip="最大化"
                    AutomationProperties.Name="最大化">
                <TextBlock x:Name="MaximizeIcon" Classes="caption-glyph" Text="&#xE922;" />
            </Button>
            <Button Classes="caption-button close-button"
                    Click="OnCloseClick"
                    ToolTip.Tip="关闭"
                    AutomationProperties.Name="关闭">
                <TextBlock Classes="caption-glyph" Text="&#xE8BB;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>