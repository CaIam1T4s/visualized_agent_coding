<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             xmlns:views="using:happy_agent_coding.Views"
             x:Class="happy_agent_coding.Views.ObjectManagerView"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="StageObjectTile" x:DataType="vm:StageObjectItem">
            <Button Classes="object-tile"
                    Classes.selected="{Binding IsSelected}"
                    Tag="{Binding}"
                    Click="OnStageObjectClick"
                    ContextRequested="OnStageObjectContextRequested"
                    ToolTip.Tip="{Binding DisplayName}"
                    AutomationProperties.Name="{Binding DisplayName}">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <Border Classes="object-tile-thumb"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center">
                        <Grid>
                        <Image Source="{Binding Picture}" Stretch="Uniform" />
                        <TextBlock IsVisible="{Binding HasImage, Converter={x:Static BoolConverters.Not}}" Text="{Binding Initial}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="72" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="StageObjectProperties" x:DataType="vm:StageObjectItem">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding KindLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding DisplayName}"
                                 IsReadOnly="True" />
                    </StackPanel>
                    <Button Content="导入图片…" Tag="{Binding}" Click="OnImportImageClick" IsEnabled="{Binding CanEditProperties}" Classes="command-button secondary" />
                    <TextBlock Text="{Binding ImageStatus}" TextWrapping="Wrap" FontSize="11" />
                    <TextBlock Text="{Binding InspectorVisibilityText}" FontSize="11" />
                    <Button Content="重新加载舞台…" Click="OnReloadStageClick" IsEnabled="{Binding CanEditProperties}" Classes="command-button secondary"
                            ToolTip.Tip="确认后放弃所有尚未保存的舞台布局修改，读取磁盘文件" />
                    <Grid IsVisible="{Binding IsSprite}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Text="X"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2"
                                   Text="Y"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Grid.Row="1" Minimum="-100000" Maximum="100000" Increment="1"
                                 Value="{Binding InspectorX}" IsEnabled="{Binding CanEditProperties}"
                                 Margin="0,4,0,8" />
                        <NumericUpDown Grid.Row="3" Minimum="-100000" Maximum="100000" Increment="1"
                                 Value="{Binding InspectorY}" IsEnabled="{Binding CanEditProperties}"
                                 Margin="0,4,0,8" />
                        <TextBlock Grid.Row="4"
                                   Text="大小"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="6"
                                   Text="方向"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <NumericUpDown Grid.Row="5" Minimum="1" Maximum="1000" Increment="1"
                                 Value="{Binding InspectorSize}" IsEnabled="{Binding CanEditProperties}"
                                 Margin="0,4,0,8" />
                        <NumericUpDown Grid.Row="7" Minimum="-180" Maximum="180" Increment="1"
                                 Value="{Binding InspectorDirection}" IsEnabled="{Binding CanEditProperties}"
                                 Margin="0,4,0,0" />
                    </Grid>
                    <StackPanel IsVisible="{Binding IsSprite}" Spacing="6">
                        <TextBlock Text="图层（数值越大越靠前）" FontSize="11" TextWrapping="Wrap" />
                        <NumericUpDown Value="{Binding InspectorLayer}" IsEnabled="{Binding CanEditProperties}" Minimum="-10000" Maximum="10000" Increment="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="前移" Command="{Binding BringForwardCommand}" IsEnabled="{Binding CanEditProperties}" />
                            <Button Content="后移" Command="{Binding SendBackwardCommand}" IsEnabled="{Binding CanEditProperties}" />
                        </StackPanel>
                        <TextBlock Text="显示"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="object-visibility"
                                    Classes.selected="{Binding InspectorVisible}"
                                    Command="{Binding ShowObjectCommand}" IsEnabled="{Binding CanEditProperties}"
                                    ToolTip.Tip="显示"
                                    AutomationProperties.Name="显示">
                                <TextBlock Classes="explorer-glyph" Text="&#xE890;" FontSize="14" />
                            </Button>
                            <Button Classes="object-visibility"
                                    Classes.selected="{Binding InspectorHidden}"
                                    Command="{Binding HideObjectCommand}" IsEnabled="{Binding CanEditProperties}"
                                    ToolTip.Tip="隐藏"
                                    AutomationProperties.Name="隐藏">
                                <ContentControl Width="14" Height="14"
                                                AttachedToVisualTree="OnHideIconAttached" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox Content="接收点击事件"
                              IsChecked="{Binding InspectorClickEnabled}"
                              IsEnabled="{Binding CanEditProperties}"
                              ToolTip.Tip="关闭后该对象不再拦截舞台点击，与显示/隐藏无关" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
    <Button Content="返回初始布局" IsVisible="{Binding HasRuntimeStagePreview}"
            Command="{Binding ReturnToInitialStageCommand}" Margin="0,0,0,8" />
    <TabControl Grid.Row="1" Classes="object-manager-tabs"
                SelectedIndex="{Binding ObjectManagerTabIndex}">
        <TabItem Header="角色">
            <Grid ColumnDefinitions="*,180" Margin="0,8,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <views:ObjectTileWrapHost ItemsSource="{Binding StageSprites}"
                                              ItemTemplate="{StaticResource StageObjectTile}"
                                              HorizontalAlignment="Stretch">
                        <views:ObjectTileWrapHost.TrailingContent>
                            <Button Classes="object-add"
                                    Command="{Binding AddSpriteCommand}"
                                    IsEnabled="{Binding CanEditInitialStage}"
                                    ToolTip.Tip="添加角色"
                                    AutomationProperties.Name="添加角色">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Classes="explorer-glyph"
                                               Text="&#xE710;"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="添加"
                                               FontSize="11"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </views:ObjectTileWrapHost.TrailingContent>
                    </views:ObjectTileWrapHost>
                </ScrollViewer>
                <ContentControl Grid.Column="1"
                                Width="180"
                                MinWidth="180"
                                MaxWidth="180"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{Binding SelectedSprite}"
                                ContentTemplate="{StaticResource StageObjectProperties}" />
            </Grid>
        </TabItem>
        <TabItem Header="背景">
            <Grid ColumnDefinitions="*,180" Margin="0,8,0,0">
            <ScrollViewer
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <views:ObjectTileWrapHost ItemsSource="{Binding StageBackdrops}"
                                          ItemTemplate="{StaticResource StageObjectTile}"
                                          HorizontalAlignment="Stretch">
                    <views:ObjectTileWrapHost.TrailingContent>
                        <Button Classes="object-add"
                                Command="{Binding AddBackdropCommand}"
                                IsEnabled="{Binding CanEditInitialStage}"
                                ToolTip.Tip="添加背景"
                                AutomationProperties.Name="添加背景">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Classes="explorer-glyph"
                                           Text="&#xE710;"
                                           FontSize="16"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="添加"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </views:ObjectTileWrapHost.TrailingContent>
                </views:ObjectTileWrapHost>
            </ScrollViewer>
            <ContentControl Grid.Column="1" Width="180" Content="{Binding SelectedBackdrop}"
                            ContentTemplate="{StaticResource StageObjectProperties}" />
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</UserControl>
