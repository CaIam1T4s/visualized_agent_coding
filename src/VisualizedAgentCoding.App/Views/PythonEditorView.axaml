<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             xmlns:python="using:VisualizedAgentCoding.Application.Python"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:avaloniaEditEditing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
             xmlns:avaloniaEditRendering="clr-namespace:AvaloniaEdit.Rendering;assembly=AvaloniaEdit"
             x:Class="happy_agent_coding.Views.PythonEditorView"
             x:DataType="vm:MainViewModel">
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            Padding="0,8,8,8">
        <Panel>
            <Border Classes="editor-surface"
                    Background="{DynamicResource LayerFillColorBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    IsVisible="{Binding IsEditorVisible, Converter={x:Static BoolConverters.Not}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="360">
                    <TextBlock Text="{Binding EditorEmptyPromptTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding EditorEmptyPromptMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Classes="command-button primary"
                            Content="打开项目管理"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding ShowOpenProjectPrompt}"
                            Command="{Binding OpenProjectManagerCommand}" />
                </StackPanel>
            </Border>
            <Border Classes="editor-surface"
                    Background="{DynamicResource LayerFillColorBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    IsVisible="{Binding IsEditorVisible}">
                <Border.Styles>
                    <Style Selector="avaloniaEditEditing|LineNumberMargin">
                        <Setter Property="Margin" Value="0,0,6,0" />
                    </Style>
                    <Style Selector="avaloniaEditRendering|TextView">
                        <Setter Property="Margin" Value="6,0,0,0" />
                    </Style>
                </Border.Styles>
                <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*"
                          Margin="12,11,12,8">
                        <ComboBox Classes="editor-mode-selector"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="{Binding EditorModeIndex}"
                                  Width="110"
                                  Height="32"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Python" />
                            <ComboBoxItem Content="图形化" />
                        </ComboBox>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileName}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <avaloniaEdit:TextEditor x:Name="EditorTextBox"
                                             Grid.Row="1"
                                             ShowLineNumbers="True"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="14"
                                             Padding="12"
                                             Background="{DynamicResource LayerFillColorBrush}"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Expander Classes="diagnostics-list" Grid.Row="2" IsVisible="{Binding HasPythonDiagnostics}"
                              Header="{Binding PythonErrorListTitle}"
                              ExpandDirection="Up" IsExpanded="False" MinHeight="32" Padding="8,4"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Margin="12,4">
                        <Expander.Resources>
                            <Thickness x:Key="ExpanderHeaderPadding">8,0</Thickness>
                            <Thickness x:Key="ExpanderChevronMargin">0</Thickness>
                            <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
                        </Expander.Resources>
                        <Expander.Styles>
                            <Style Selector="Expander.diagnostics-list /template/ ToggleButton#ExpanderHeader">
                                <Setter Property="Height" Value="32" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                            <Style Selector="Expander.diagnostics-list /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#ContentPresenter">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Margin" Value="24,0,0,0" />
                            </Style>
                            <Style Selector="Expander.diagnostics-list /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="Expander.diagnostics-list /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#Root">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Style>
                            <Style Selector="Expander.diagnostics-list /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ExpandCollapseChevronBorder">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Expander.Styles>
                        <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding PythonDiagnostics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="python:PythonDiagnostic">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Height="32" MinHeight="32" Padding="12,0" Margin="0"
                                            VerticalContentAlignment="Center" ToolTip.Tip="{Binding DisplayText}"
                                            Classes="command-button secondary" Tag="{Binding}" Click="OnDiagnosticClick"
                                            AutomationProperties.Name="{Binding DisplayText}">
                                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                    <Border Grid.Row="3"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,12,0">
                                <TextBlock Text="{Binding PythonErrorSummary}" ToolTip.Tip="{Binding PythonAnalysisStatus}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding EditorOperationStatus}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="420" ToolTip.Tip="{Binding EditorOperationStatus}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Text="Python · UTF-8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Panel>
    </Border>
</UserControl>
