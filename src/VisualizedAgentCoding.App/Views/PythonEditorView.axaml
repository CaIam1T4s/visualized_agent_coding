<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:avaloniaEditEditing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
             xmlns:avaloniaEditRendering="clr-namespace:AvaloniaEdit.Rendering;assembly=AvaloniaEdit"
             x:Class="happy_agent_coding.Views.PythonEditorView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Styles>
            <Style Selector="avaloniaEditEditing|LineNumberMargin">
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style Selector="avaloniaEditRendering|TextView">
                                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </Grid.Styles>
        <Grid Grid.Row="0"
              Margin="16,16,16,0"
              ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12">
            <ComboBox Grid.Column="0"
                      Classes="editor-mode-selector"
                      SelectedIndex="{Binding EditorModeIndex}"
                      ToolTip.Tip="切换编辑器模式"
                      AutomationProperties.Name="切换编辑器模式">
                <ComboBoxItem Content="图形化积木" />
                <ComboBoxItem Content="Python 编辑器" />
            </ComboBox>
            <TextBlock Grid.Column="1"
                       Text="{Binding FileName}"
                       FontFamily="Consolas"
                       FontSize="14"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Classes="editor-surface"
                Margin="16,12,16,0"
                Background="{DynamicResource LayerFillColorBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
                <avaloniaEdit:TextEditor x:Name="EditorTextBox"
                                         Grid.Row="0"
                                         ShowLineNumbers="True"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         Padding="12"
                                         Background="{DynamicResource LayerFillColorBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Grid.Row="1"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EditorState}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Text="Python · UTF-8"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   FontSize="12" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
