<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="happy_agent_coding.Views.ScriptUpgradeView"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#99000000">
        <Border Width="860" MaxHeight="600" Margin="24" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,10,20,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="升级脚本模板" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="caption-button" Click="OnCancel" AutomationProperties.Name="关闭升级预览">
                            <TextBlock Classes="caption-glyph" Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Margin="24,16" TextWrapping="Wrap"
                    Text="原用户代码将完整保留到“类定义”，新增“程序启动时运行”区域。不会自动移动代码或保存磁盘；确认后可撤销，保存时仍会检查磁盘冲突。" />
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="24,0" MinHeight="250">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="升级前" Margin="0,0,0,8" />
                        <edit:TextEditor x:Name="OriginalCode" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True"
                            FontFamily="Consolas" FontSize="14" Padding="8" Background="{DynamicResource LayerFillColorBrush}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <TextBlock Text="升级后" Margin="0,0,0,8" />
                        <edit:TextEditor x:Name="UpgradedCode" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True"
                            FontFamily="Consolas" FontSize="14" Padding="8" Background="{DynamicResource LayerFillColorBrush}"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="24,16">
                    <Button Content="取消" Classes="command-button secondary" Click="OnCancel" />
                    <Button Content="确认升级" Classes="command-button primary" Click="OnConfirm" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
