<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:happy_agent_coding.ViewModels"
        xmlns:views="using:happy_agent_coding.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="happy_agent_coding.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Python 编辑器 - Visualized Agent Coding"
        WindowDecorations="None"
        MinWidth="1100"
        MinHeight="700">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="36,*" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <views:TitleBarView Grid.Row="0" />
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" MinWidth="0" ColumnDefinitions="Auto,1*,5,1*">
                <views:SidebarView x:Name="SidebarView"
                                   Grid.Column="0"
                                   VerticalAlignment="Stretch" />

            <Grid x:Name="MainContentGrid" Grid.Column="1" MinWidth="0" RowDefinitions="1*,5,1*">
                <Border Grid.Row="0"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Classes="workspace-view-selector"
                                  SelectedIndex="0"
                                  ToolTip.Tip="切换工作区页面"
                                  AutomationProperties.Name="切换工作区页面"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top">
                            <ComboBoxItem Content="终端" />
                            <ComboBoxItem Content="舞台" />
                        </ComboBox>
                        <Button Grid.Column="1"
                                Classes="command-button primary"
                                Command="{Binding RunCommand}"
                                Width="86"
                                Height="32"
                                MinHeight="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <Grid Width="54" ColumnDefinitions="16,8,*"
                                  HorizontalAlignment="Center">
                                <ContentControl x:Name="RunIcon"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="运行"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <GridSplitter x:Name="HorizontalLayoutSplitter" Grid.Row="1"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

                <Border Grid.Row="2"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,0"
                        Padding="16">
                    <TextBlock Text="中间页面"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top" />
                </Border>
            </Grid>

            <GridSplitter x:Name="VerticalLayoutSplitter" Grid.Column="2"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

                <Border Grid.Column="3"
                        MinWidth="0"
                        ClipToBounds="True"
                        Margin="0,0,0,16"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Stretch">
                    <views:PythonEditorView VerticalAlignment="Stretch" />
                </Border>
        </Grid>
        <views:SettingsView Grid.Row="0"
                            Grid.RowSpan="2"
                            IsVisible="{Binding IsSettingsOpen}" />
    </Grid>
</Window>
