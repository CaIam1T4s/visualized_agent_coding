<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:happy_agent_coding.ViewModels"
        xmlns:views="using:happy_agent_coding.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="happy_agent_coding.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Python 编辑器 - Visualized Agent Coding"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="True"
        MinWidth="1100"
        MinHeight="700">

    <Window.Styles>
        <Style Selector="Border.window-frame">
            <Setter Property="Margin" Value="10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BoxShadow" Value="0 2 12 0 #80000000" />
        </Style>
        <Style Selector="Border.window-frame.maximized">
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame"
                Classes="window-frame"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid RowDefinitions="36,*" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <views:TitleBarView x:Name="TitleBarView" Grid.Row="0" />
                <views:WorkspaceView Grid.Row="1" />
                <views:SettingsView x:Name="SettingsViewHost"
                                    Grid.RowSpan="2"
                                    IsVisible="{Binding IsSettingsOpen}" />
                <views:ProjectManagerView x:Name="ProjectManagerViewHost"
                                          Grid.RowSpan="2"
                                          IsVisible="{Binding IsProjectManagerOpen}" />
            </Grid>
        </Border>

        <Grid x:Name="ResizeGripGrid"
              ColumnDefinitions="12,*,12"
              RowDefinitions="12,*,12"
              IsHitTestVisible="False">
            <Border Grid.Column="0" Grid.Row="1" Width="6" HorizontalAlignment="Left"
                    Background="Transparent" IsHitTestVisible="True" Tag="West"
                    PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="2" Grid.Row="1" Width="6" HorizontalAlignment="Right"
                    Background="Transparent" IsHitTestVisible="True" Tag="East"
                    PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="1" Grid.Row="0" Height="6" VerticalAlignment="Top"
                    Background="Transparent" IsHitTestVisible="True" Tag="North"
                    PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="1" Grid.Row="2" Height="6" VerticalAlignment="Bottom"
                    Background="Transparent" IsHitTestVisible="True" Tag="South"
                    PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="0" Grid.Row="0" Width="12" Height="12" Background="Transparent"
                    IsHitTestVisible="True" Tag="NorthWest" PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="2" Grid.Row="0" Width="12" Height="12" Background="Transparent"
                    IsHitTestVisible="True" Tag="NorthEast" PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="0" Grid.Row="2" Width="12" Height="12" Background="Transparent"
                    IsHitTestVisible="True" Tag="SouthWest" PointerPressed="OnResizeGripPointerPressed" />
            <Border Grid.Column="2" Grid.Row="2" Width="12" Height="12" Background="Transparent"
                    IsHitTestVisible="True" Tag="SouthEast" PointerPressed="OnResizeGripPointerPressed" />
        </Grid>
    </Grid>
</Window>