<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             x:Class="happy_agent_coding.Views.ScriptRenameView" x:DataType="vm:MainViewModel"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelRenameScriptCommand}" />
    </UserControl.KeyBindings>
    <Border Background="#99000000">
        <Border MaxWidth="900" Margin="24" Padding="24" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock Text="重命名修改预览" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding RenamePreviewStatus}" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RenameChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptRenamePreviewItem">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                                    <TextBlock Text="修改前" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Before}" FontFamily="Consolas" />
                                    <TextBlock Text="修改后" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding After}" FontFamily="Consolas" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollViewer MaxHeight="100" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding RenamePreviewError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="取消" Classes="command-button secondary" Command="{Binding CancelRenameScriptCommand}" />
                    <Button Content="修改名称" Classes="command-button secondary" Command="{Binding BackToRenameCommand}" />
                    <Button Content="应用重命名" Classes="command-button primary" IsEnabled="{Binding CanApplyRename}"
                            Command="{Binding ApplyRenameCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
