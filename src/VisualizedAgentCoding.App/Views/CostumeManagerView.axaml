<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             x:Class="happy_agent_coding.Views.CostumeManagerView"
             KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="#99000000">
        <Border Width="700" MaxWidth="820" MaxHeight="680" Margin="24" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,10,20,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="TitleText" Text="管理造型" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="caption-button" Click="OnClose" ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
                            <TextBlock Classes="caption-glyph" Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,220" Margin="24" ColumnSpacing="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="造型列表" />
                        <ListBox x:Name="CostumeList" MinHeight="240" MaxHeight="400"
                                 SelectionChanged="OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StageCostumeItem">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="添加造型…" Click="OnAdd" Classes="command-button secondary" />
                            <Button Content="删除选中" Click="OnRemove" Classes="command-button secondary" />
                        </StackPanel>
                        <TextBlock Text="添加造型会复制并校验图片；保存项目后写入舞台文件。"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="初始造型" />
                        <TextBlock x:Name="InitialCostumeText" TextWrapping="Wrap" />
                        <TextBlock Text="造型名称" Margin="0,8,0,0" />
                        <TextBox x:Name="CostumeNameBox" PlaceholderText="输入造型名称" />
                        <Button Content="重命名选中造型" Click="OnRename" Classes="command-button secondary" />
                        <Button Content="设为初始造型" Click="OnSetInitial" Classes="command-button primary" />
                        <TextBlock x:Name="ErrorText" IsVisible="False" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                    <Button Content="关闭" HorizontalAlignment="Right" Classes="command-button primary" Click="OnClose" />
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
