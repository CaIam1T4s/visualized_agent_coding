<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:happy_agent_coding.ViewModels"
             xmlns:views="using:happy_agent_coding.Views"
             x:Class="happy_agent_coding.Views.WorkspaceView"
             x:DataType="vm:MainViewModel">
    <Grid x:Name="WorkspaceGrid"
          ColumnDefinitions="Auto,520,8,*"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <views:SidebarView x:Name="Sidebar" Grid.Column="0" />
        <Grid x:Name="LeftWorkspaceGrid" Grid.Column="1" Margin="8,8,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="350" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="180" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    MinHeight="350"
                    Background="{DynamicResource LayerFillColorBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <Grid x:Name="StageToolbar" HorizontalAlignment="Center"
                          ColumnDefinitions="Auto,*"
                          Margin="0,0,0,8">
                        <Button Classes="command-button primary stage-run-button"
                                Command="{Binding RunCommand}"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Margin="0,0,12,0"
                                MinWidth="86">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ContentControl x:Name="RunIcon"
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RunButtonText}"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ComboBox Grid.Column="1"
                                  Classes="workspace-view-selector"
                                  Width="88"
                                  HorizontalAlignment="Right"
                                  SelectedIndex="{Binding StageViewIndex}">
                            <ComboBoxItem Content="终端" />
                            <ComboBoxItem Content="舞台" />
                        </ComboBox>
                    </Grid>
                    <Panel x:Name="StagePreviewHost"
                           Grid.Row="1">
                        <Border x:Name="StageFrame" IsVisible="{Binding IsStageVisible}"
                                Background="Transparent"
                                CornerRadius="8"
                                MinWidth="360"
                                MinHeight="270"
                                ClipToBounds="True">
                            <Panel x:Name="StageCanvasHost">
                                <Border IsVisible="{Binding ShowStageCanvas, Converter={x:Static BoolConverters.Not}}"
                                        Background="Transparent">
                                    <TextBlock Text="{Binding EditorEmptyPromptMessage}"
                                               MaxWidth="320"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Viewbox x:Name="StageCanvasViewbox"
                                         Stretch="Uniform"
                                         IsVisible="{Binding ShowStageCanvas}">
                                    <Border Width="480"
                                            Height="360"
                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            ClipToBounds="True">
                                        <Grid><Canvas x:Name="StageCanvas"
                                                Width="480"
                                                Height="360"
                                                Background="Transparent"
                                                PointerPressed="OnStageCanvasPointerPressed"
                                                PointerMoved="OnStageCanvasPointerMoved"
                                                PointerReleased="OnStageCanvasPointerReleased"
                                                PointerCaptureLost="OnStageCanvasPointerCaptureLost">
                                            <ContentControl Width="480"
                                                            Height="360"
                                                            Content="{Binding CurrentBackdrop}"
                                                            IsHitTestVisible="False">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:StageObjectItem">
                                                        <Border Classes="stage-backdrop"
                                                                Width="480"
                                                                Height="360">
                                                            <Grid>
                                                            <Image Source="{Binding Picture}" Stretch="{Binding BackdropStretch}"
                                                                   Width="{Binding BackdropImageWidth}" Height="{Binding BackdropImageHeight}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <TextBlock IsVisible="{Binding HasImage, Converter={x:Static BoolConverters.Not}}" Text="{Binding DisplayName}"
                                                                       FontSize="28"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <ItemsControl Width="480"
                                                           Height="360"
                                                           ItemsSource="{Binding StageSprites}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="480" Height="360" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter" x:DataType="vm:StageObjectItem">
                                                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                                        <Setter Property="ZIndex" Value="{Binding Layer}" />
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StageObjectItem">
                                                        <Border Classes="stage-sprite"
                                                                BorderThickness="0"
                                                                Classes.has-image="{Binding HasImage}"
                                                                Classes.selected="{Binding IsSelected}"
                                                                IsHitTestVisible="{Binding IsVisible}"
                                                                Width="{Binding SpriteWidth}"
                                                                Height="{Binding SpriteHeight}"
                                                                Opacity="{Binding StageOpacity}"
                                                                Tag="{Binding}"
                                                                Cursor="SizeAll"
                                                                PointerPressed="OnStageSpritePointerPressed"
                                                                ToolTip.Tip="{Binding DisplayName}"
                                                                AutomationProperties.Name="{Binding DisplayName}">
                                                            <Border.RenderTransformOrigin>
                                                                <RelativePoint>0.5,0.5</RelativePoint>
                                                            </Border.RenderTransformOrigin>
                                                            <Border.RenderTransform>
                                                                <RotateTransform Angle="{Binding Rotation}" />
                                                            </Border.RenderTransform>
                                                            <Grid>
                                                            <Image Source="{Binding Picture}" Stretch="Uniform" />
                                                            <TextBlock IsVisible="{Binding HasImage, Converter={x:Static BoolConverters.Not}}" Text="{Binding Initial}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Border Classes="stage-sprite-outline" Classes.selected="{Binding IsSelected}" IsHitTestVisible="False" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas><Border IsHitTestVisible="False" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" /></Grid>
                                    </Border>
                                </Viewbox>
                            </Panel>
                        </Border>
                        <views:TerminalView IsVisible="{Binding IsTerminalVisible}" />
                    </Panel>
                </Grid>
            </Border>
            <GridSplitter x:Name="HorizontalSplitter"
                          Grid.Row="1"
                          Height="8"
                          Opacity="0"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" />
            <Border Grid.Row="2"
                    MinHeight="180"
                    Background="{DynamicResource LayerFillColorBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12,12,8">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="资源管理器"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Classes="workspace-view-selector"
                                  SelectedIndex="{Binding ResourceExplorerModeIndex}">
                            <ComboBoxItem Content="资源筛选器" />
                            <ComboBoxItem Content="对象管理器" />
                        </ComboBox>
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding ResourceSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="按名称或路径筛选脚本"
                             IsVisible="{Binding IsResourceFilterMode}"
                             Margin="0,8,0,8" />
                    <Panel Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      IsVisible="{Binding IsResourceFilterMode}">
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding ScriptCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptCategory">
                                            <Border Background="Transparent"
                                                    ContextRequested="OnCategoryContextRequested">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <ToggleButton Classes="explorer-category-header"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Title}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Classes="explorer-chevron"
                                                                           Text="&#xE76C;"
                                                                           IsVisible="{Binding IsCollapsed}" />
                                                                <TextBlock Classes="explorer-chevron"
                                                                           Text="&#xE70D;"
                                                                           IsVisible="{Binding IsExpanded}" />
                                                                <TextBlock Classes="explorer-category-title"
                                                                           Text="{Binding Title}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Button Grid.Column="1"
                                                                Classes="explorer-action"
                                                                ToolTip.Tip="{Binding CreateMenuHeader}"
                                                                AutomationProperties.Name="{Binding CreateMenuHeader}"
                                                                IsEnabled="{Binding CanCreate}"
                                                                Command="{Binding StartCreateCommand}">
                                                            <TextBlock Classes="explorer-glyph" Text="&#xE710;" />
                                                        </Button>
                                                    </Grid>
                                                    <StackPanel Spacing="6"
                                                                Margin="14,4,0,0"
                                                                IsVisible="{Binding IsExpanded}">
                                                        <StackPanel Spacing="6" IsVisible="{Binding IsCreating}">
                                                            <TextBox Text="{Binding NewScriptName, UpdateSourceTrigger=PropertyChanged}"
                                                                     PlaceholderText="脚本名">
                                                                <TextBox.KeyBindings>
                                                                    <KeyBinding Gesture="Enter"
                                                                                Command="{Binding ConfirmCreateCommand}" />
                                                                    <KeyBinding Gesture="Escape"
                                                                                Command="{Binding CancelCreateCommand}" />
                                                                </TextBox.KeyBindings>
                                                            </TextBox>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button Classes="command-button secondary explorer-inline-button"
                                                                        Content="创建"
                                                                        Command="{Binding ConfirmCreateCommand}" />
                                                                <Button Classes="command-button secondary explorer-inline-button"
                                                                        Content="取消"
                                                                        Command="{Binding CancelCreateCommand}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       IsVisible="{Binding HasError}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="暂无脚本"
                                                                   Margin="8,5"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   IsVisible="{Binding IsEmpty}" />
                                                        <ItemsControl ItemsSource="{Binding Scripts}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ProjectScriptItem">
                                                                    <StackPanel Classes="script-row">
                                                                    <Button Classes="explorer-item"
                                                                            ContextRequested="OnScriptContextRequested"
                                                                            IsVisible="{Binding IsRenaming, Converter={x:Static BoolConverters.Not}}"
                                                                            Classes.open="{Binding IsOpen}"
                                                                            ToolTip.Tip="{Binding RelativePath}"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Left"
                                                                            Tag="{Binding}"
                                                                            Click="OnScriptItemClick">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,5">
                                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                                            <ContentControl Width="16" Height="16" VerticalAlignment="Center"
                                                                                IsVisible="{Binding NeedsTemplateUpgrade}"
                                                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                                ToolTip.Tip="{Binding TemplateUpgradeHint}"
                                                                                AutomationProperties.Name="旧版脚本，请升级模板"
                                                                                AttachedToVisualTree="OnUpgradeWarningAttached" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                        <ContentControl Content="{Binding RenameState}" IsVisible="{Binding IsRenaming}">
                                                                            <ContentControl.ContentTemplate>
                                                                                <DataTemplate x:DataType="vm:ScriptRenameState">
                                                                                    <StackPanel Spacing="4">
                                                                                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                 AutomationProperties.Name="重命名脚本"
                                                                                                 AttachedToVisualTree="OnRenameAttached"
                                                                                                 LostFocus="OnRenameLostFocus">
                                                                                            <TextBox.KeyBindings>
                                                                                                <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
                                                                                                <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                                                                            </TextBox.KeyBindings>
                                                                                        </TextBox>
                                                                                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
                                                                                                   TextWrapping="Wrap" FontSize="11"
                                                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ContentControl.ContentTemplate>
                                                                        </ContentControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <views:ObjectManagerView IsVisible="{Binding IsObjectManagerMode}" />
                    </Panel>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProjectResourceMessage}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProjectResourceStatus}"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter x:Name="VerticalSplitter"
                      Grid.Column="2"
                      Width="8"
                      Opacity="0"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" />
        <views:PythonEditorView Grid.Column="3" />
    </Grid>
</UserControl>
