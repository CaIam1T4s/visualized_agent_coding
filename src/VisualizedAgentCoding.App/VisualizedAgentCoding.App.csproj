<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\tools\python-helper\*.py" Exclude="..\..\tools\python-helper\test_*.py"
             Link="python-helper\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\python-helper\vendor\**\*"
             Exclude="..\..\tools\python-helper\vendor\**\__pycache__\**;..\..\tools\python-helper\vendor\**\*.pyc"
             Link="python-helper\vendor\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="AvaloniaFluentUI" Version="2.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AtomUI.Icons.AntDesign" Version="6.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualizedAgentCoding.Domain\VisualizedAgentCoding.Domain.csproj" />
    <ProjectReference Include="..\VisualizedAgentCoding.Application\VisualizedAgentCoding.Application.csproj" />
    <ProjectReference Include="..\VisualizedAgentCoding.Infrastructure\VisualizedAgentCoding.Infrastructure.csproj" />
  </ItemGroup>
</Project>
