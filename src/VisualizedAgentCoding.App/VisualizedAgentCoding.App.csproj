<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\VisualizedAgentCoding.Python.Runtime\**\*.py" Exclude="**\__pycache__\**"
             Link="python-runtime\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="..\..\tools\python-helper\*.py" Exclude="..\..\tools\python-helper\test_*.py"
             Link="python-helper\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>

  <PropertyGroup>
    <HelperPython Condition="'$(HelperPython)' == ''">python</HelperPython>
    <HelperVendor>$(MSBuildProjectDirectory)/../../artifacts/python-helper/vendor</HelperVendor>
  </PropertyGroup>
  <Target Name="PreparePythonHelperDependencies" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(HelperPython)&quot; &quot;$(MSBuildProjectDirectory)/../../tools/python-helper/scripts/prepare_dependencies.py&quot;" />
    <ItemGroup>
      <_HelperDependency Include="$(HelperVendor)/**/*" Exclude="$(HelperVendor)/**/__pycache__/**;$(HelperVendor)/**/*.pyc;$(HelperVendor)/.requirements.sha256" />
      <Content Include="@(_HelperDependency)">
        <Link>python-helper/vendor/%(_HelperDependency.RecursiveDir)%(_HelperDependency.Filename)%(_HelperDependency.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="AvaloniaFluentUI" Version="2.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AtomUI.Icons.AntDesign" Version="6.2.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisualizedAgentCoding.Domain\VisualizedAgentCoding.Domain.csproj" />
    <ProjectReference Include="..\VisualizedAgentCoding.Application\VisualizedAgentCoding.Application.csproj" />
    <ProjectReference Include="..\VisualizedAgentCoding.Infrastructure\VisualizedAgentCoding.Infrastructure.csproj" />
  </ItemGroup>
</Project>
